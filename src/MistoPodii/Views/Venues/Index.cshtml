@model IReadOnlyList<Venue>
@{ ViewData["Title"] = "Місця"; }
<div class="page-shell"><div class="page-heading"><div><p class="eyebrow">Міська мапа</p><h1>Місця</h1></div><a class="btn btn-primary" asp-action="Create">Додати місце</a></div><div class="data-panel">
@if (Model.Count == 0) { <p>Місць поки немає. Додайте перше, щоб створювати події.</p> }
else { <table class="data-table"><thead><tr><th>Назва</th><th>Адреса</th><th>Дії</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><a asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td><td>@item.Address</td><td><div class="action-links"><a asp-action="Edit" asp-route-id="@item.Id">Змінити</a><a asp-action="Delete" asp-route-id="@item.Id">Видалити</a></div></td></tr> }</tbody></table> }
</div></div>

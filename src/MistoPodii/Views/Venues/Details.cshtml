@model Venue
@{ ViewData["Title"] = Model.Name; }
<div class="page-shell"><div class="page-heading"><div><p class="eyebrow">Місце</p><h1>@Model.Name</h1></div><div class="action-links"><a asp-action="Edit" asp-route-id="@Model.Id">Змінити</a><a asp-action="Index">Усі місця</a></div></div><div class="detail-grid"><div><h2 class="h4">Адреса</h2><p>@Model.Address</p><h2 class="h4">Події тут</h2>@if (Model.Events.Count == 0) { <p>Подій поки немає.</p> } else { <ul>@foreach (var item in Model.Events.OrderBy(e => e.StartsAtUtc)) { <li><a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></li> }</ul> }</div><aside class="detail-aside"><h2 class="h4">Дані місця</h2><dl><dt>Місткість</dt><dd>@Model.Capacity людей</dd><dt>Координати</dt><dd>@Model.Latitude, @Model.Longitude</dd></dl></aside></div></div>

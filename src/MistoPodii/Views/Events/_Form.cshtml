@model Event
<div asp-validation-summary="ModelOnly" class="mb-3"></div>
<div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title"></span></div>
<div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="6"></textarea><span asp-validation-for="Description"></span></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" placeholder="Наприклад, майстерня" /><span asp-validation-for="Category"></span></div><div class="col-md-6 mb-3"><label asp-for="StartsAtUtc" class="form-label"></label><input asp-for="StartsAtUtc" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" /><span asp-validation-for="StartsAtUtc"></span><small class="form-text">Введіть час за UTC.</small></div></div>
<div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<EventStatus>()" class="form-select"></select><span asp-validation-for="Status"></span></div>
<div class="mb-3"><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" class="form-control" placeholder="/images/posters.svg або https://…" /><span asp-validation-for="ImageUrl"></span></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="OrganizerId" class="form-label"></label><select asp-for="OrganizerId" asp-items="ViewBag.Organizers" class="form-select"><option value="0">Оберіть організатора</option></select><span asp-validation-for="OrganizerId"></span></div><div class="col-md-6 mb-3"><label for="venue-search" class="form-label">Місце</label><div class="autocomplete"><input id="venue-search" type="text" class="form-control" value="@ViewBag.VenueName" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="venue-suggestions" data-url="@Url.Action("Suggest", "Venues")" placeholder="Введіть щонайменше 3 символи" /><ul id="venue-suggestions" class="autocomplete-list" role="listbox" hidden></ul></div><input asp-for="VenueId" type="hidden" /><span asp-validation-for="VenueId"></span><small class="form-text">Виберіть місце зі списку пропозицій.</small></div></div>
<button type="submit" class="btn btn-primary">Зберегти</button> <a asp-action="Index" class="btn btn-link">Скасувати</a>

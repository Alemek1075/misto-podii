@model Event
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Description.Length > 155 ? Model.Description[..155] : Model.Description;
    ViewData["CanonicalUrl"] = Url.Action("Details", "Events", new { id = Model.Id }, Context.Request.Scheme);
    ViewData["OgImage"] = Model.ImageUrl.StartsWith('/')
        ? $"{Context.Request.Scheme}://{Context.Request.Host}{Model.ImageUrl}"
        : Model.ImageUrl;
    var weather = (MistoPodii.Services.WeatherResult)ViewData["Weather"]!;
}
<div class="page-shell"><div class="page-heading"><div><p class="eyebrow">@Model.Category <span class="event-status" data-event-id="@Model.Id">@EventStatusLabels.Get(Model.Status)</span></p><h1>@Model.Title</h1></div><div class="action-links"><a asp-action="Edit" asp-route-id="@Model.Id">Змінити</a><a asp-controller="Home" asp-action="Index">До афіші</a></div></div>
<img class="detail-photo" src="@Model.ImageUrl" alt="Ілюстрація події @Model.Title" />
<div class="detail-grid"><div><h2 class="h4">Про подію</h2><p class="detail-copy">@Model.Description</p></div><aside class="detail-aside"><h2 class="h4">Де і коли</h2><dl><dt>Початок</dt><dd>@Model.StartsAtUtc.ToString("dd.MM.yyyy HH:mm") UTC</dd><dt>Місце</dt><dd><a asp-controller="Venues" asp-action="Details" asp-route-id="@Model.VenueId">@Model.Venue.Name</a><br />@Model.Venue.Address</dd><dt>Організатор</dt><dd><a asp-controller="Organizers" asp-action="Details" asp-route-id="@Model.OrganizerId">@Model.Organizer.Name</a></dd></dl><div class="weather"><h3 class="h5">Погода в день події</h3>@if (weather.Forecast is { } forecast) { <p><strong>@forecast.MinCelsius.ToString("0.#")–@forecast.MaxCelsius.ToString("0.#") °C</strong></p><p>Ймовірність опадів: @(forecast.RainChancePercent?.ToString() ?? "немає даних")%</p> } else { <p>@weather.Message</p> }<small>Прогноз: <a href="https://open-meteo.com/" rel="noopener noreferrer">Open-Meteo</a></small></div></aside></div>
<aside class="contact-dock" aria-label="Контакт організатора"><span>Контакт організатора</span><strong>@Model.Organizer.Contact</strong></aside>
</div>
@{
    var eventSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Event",
        ["name"] = Model.Title,
        ["description"] = Model.Description,
        ["startDate"] = DateTime.SpecifyKind(Model.StartsAtUtc, DateTimeKind.Utc).ToString("O"),
        ["image"] = ViewData["OgImage"],
        ["location"] = new Dictionary<string, object> { ["@type"] = "Place", ["name"] = Model.Venue.Name, ["address"] = Model.Venue.Address },
        ["organizer"] = new Dictionary<string, object> { ["@type"] = "Organization", ["name"] = Model.Organizer.Name }
    };
}
<script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(eventSchema))</script>
